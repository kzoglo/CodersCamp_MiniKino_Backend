{
  "name": "coderscamp_minikino_backend",
  "version": "2.1.0",
  "description": "REST API for cinema tickets reservation.",
  "main": "index.js",
  "scripts": {
    "test": "bash test-run.sh",
    "test:container": "cross-env NODE_ENV=testing mocha \"test/**/*.test.js\" --exit",
    "test:container:file": "cross-env NODE_ENV=testing mocha \"$TEST_FILE\" --exit",
    "dev": "nodemon index.js",
    "start": "bash docker-start.sh",
    "start:prod": "node index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check . || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ci": "npm run format:check && npm run lint && npm install",
    "precommit": "npm run format && npm run lint:fix"
  },
  "engines": {
    "npm": "10.7.0",
    "node": "20.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kzoglo/CodersCamp_MiniKino_Backend"
  },
  "keywords": [
    "cinema",
    "REST",
    "API",
    "tickets",
    "reservation"
  ],
  "author": "Kamil Żogło",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kzoglo/CodersCamp_MiniKino_Backend/issues"
  },
  "homepage": "https://github.com/kzoglo/CodersCamp_MiniKino_Backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "config": "^3.2.4",
    "express": "^4.17.1",
    "helmet": "^7.1.0",
    "joi": "^17.2.1",
    "joi-objectid": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.4",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.1",
    "cross-env": "^7.0.2",
    "eslint": "^8.57.0",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.2",
    "nyc": "^15.1.0",
    "prettier": "^3.4.2",
    "proxyquire": "^2.1.3",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0"
  }
}
